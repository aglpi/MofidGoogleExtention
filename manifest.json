{
  "manifest_version": 3,
  "name": "آپشن های مربوط به کارگزاری های بورس",
  "version": "1.0.0",

  "permissions": [
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://d.easytrader.ir/*", "https://www.nahayatnegar.com/*", "https://atisaz.exirbroker.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "کارگزاری مفید"
  },

  "icons": {
    "16": "Image/stockEarnings16.png",
    "32": "Image/stockEarnings32.png",
    "128": "Image/stockEarnings128.png"
  }
}